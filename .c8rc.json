{
	"all": true,
	"include": ["out/**/*.js"],
	"exclude": ["out/test/**", "out/**/*.test.js", "out/test/helpers/**"],
	"reporter": ["text", "text-summary", "lcov", "html", "json-summary"],
	"check-coverage": true,
	"lines": 98,
	"functions": 99,
	"branches": 96,
	"statements": 98,
	"skip-full": false,
	"temp-directory": ".nyc_output",
	"report-dir": "coverage"
}
